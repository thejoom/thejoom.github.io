---
import BaseLayout from './BaseLayout.astro';
import { BLOG_BASE, categoryLabels, formatDate, getCanonicalUrl } from '../lib/blog';

const { post } = Astro.props;
const canonicalPath = `${BLOG_BASE}/${post.slug}/`;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  keywords: post.data.tags,
  mainEntityOfPage: getCanonicalUrl(canonicalPath),
  author: {
    '@type': 'Organization',
    name: '더줌',
    url: 'https://www.thejoom.net/',
  },
  publisher: {
    '@type': 'Organization',
    name: '더줌',
    url: 'https://www.thejoom.net/',
  },
  image: 'https://www.thejoom.net/static/images/logo/og-cover.png',
};
---

<BaseLayout title={`${post.data.title} | thejoom blog`} description={post.data.description} canonicalPath={canonicalPath}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <article class="post">
    <header class="post-header">
      <p class="meta">
        <a class="category-link" href={`${BLOG_BASE}/category/${post.data.category}/`}>{categoryLabels[post.data.category]}</a>
        · Published {formatDate(post.data.pubDate)}
        {post.data.updatedDate && <> · Updated {formatDate(post.data.updatedDate)}</>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <p class="meta post-tags">
          {post.data.tags.map((tag) => (
            <a class="tag-link" href={`${BLOG_BASE}/tags/${encodeURIComponent(tag)}/`}>#{tag} </a>
          ))}
        </p>
      )}
    </header>
    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>
