---
import { BLOG_BASE, categoryLabels, getCanonicalUrl, getCategoryUrl } from '../lib/blog';
import '../styles/blog.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = `${BLOG_BASE}/` } = Astro.props;
const canonical = getCanonicalUrl(canonicalPath);
const categories = Object.entries(categoryLabels);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="thejoom blog" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="thejoom blog RSS" href={getCanonicalUrl(`${BLOG_BASE}/rss.xml`)} />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand-link" href={`${BLOG_BASE}/`}>thejoom blog</a>
        <nav class="site-nav" aria-label="Blog categories">
          {categories.map(([category, label]) => (
            <a class="nav-link" href={getCategoryUrl(category)}>{label}</a>
          ))}
        </nav>
        <nav class="utility-nav" aria-label="Site links">
          <a class="nav-link" href="/">Home</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>© thejoom blog</span>
        <a href={`${BLOG_BASE}/rss.xml`}>RSS</a>
        <a class="footer-cta" href="/">업무 자동화·시스템 개발 상담</a>
      </footer>
    </div>
  </body>
</html>
