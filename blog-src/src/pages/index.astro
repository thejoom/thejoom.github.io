---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BLOG_BASE, categoryLabels, formatDate, getPostUrl, getCategoryUrl } from '../lib/blog';
import { getPublishedPosts } from '../lib/blog';

const posts = await getPublishedPosts();
---

<BaseLayout title="홈페이지 제작·업무 자동화·QA·광고 안내 | 더줌 블로그" description="홈페이지 제작 비용과 범위, 업무 자동화, QA·UX/UI 테스트, 네이버·구글 광고와 SEO를 실제 상담에서 자주 나오는 질문 중심으로 정리합니다." canonicalPath={`${BLOG_BASE}/`}>
  <header class="page-header">
    <p class="eyebrow">Field notes</p>
    <h1>thejoom blog</h1>
    <p class="lede">20년 개발 경험과 AI 에이전트 운영 기록을 실무 관점에서 정리합니다.</p>
  </header>
  {posts.length > 0 ? (
    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <p class="meta">
            {formatDate(post.data.pubDate)}
            · <a class="category-link" href={getCategoryUrl(post.data.category)}>{categoryLabels[post.data.category]}</a>
          </p>
          <h2><a href={getPostUrl(post.slug)}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  ) : (
    <p>아직 올린 글이 없습니다.</p>
  )}
</BaseLayout>
